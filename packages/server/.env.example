# Duet WebSocket server settings (all optional; defaults shown).
PORT=4000
# Postgres for saved rooms (op log + snapshots). Leave unset to keep rooms in memory only.
# Local: docker run -d --name duet-pg -e POSTGRES_USER=duet -e POSTGRES_PASSWORD=duet -e POSTGRES_DB=duet -p 5433:5432 postgres:16-alpine
DATABASE_URL=
# ot = operational transformation (normal). naive = whole-file rebroadcast baseline, for measurements only.
DUET_SYNC=ot
DUET_MAX_PEERS=4
DUET_MAX_ROOMS=1000
# Drop rooms nobody has been in for this long (ms).
DUET_EMPTY_ROOM_TTL_MS=1800000
# Ping interval (ms); a socket that misses one ping is disconnected.
DUET_HEARTBEAT_MS=30000
