{
  "name": "duet",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p packages/ot && tsc -p packages/server && tsc -p packages/web && tsc -p packages/bench",
    "server": "npm run start -w @duet/server --",
    "web": "npm run dev -w @duet/web --",
    "bench": "npm run bench -w @duet/bench --",
    "e2e": "npm run e2e -w @duet/bench --",
    "demo": "npm run demo -w @duet/bench --",
    "recovery": "npm run recovery -w @duet/bench --",
    "reconnect": "npm run reconnect -w @duet/bench --"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
